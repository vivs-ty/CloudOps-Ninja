# Example Terraform Variables File
# Copy this to terraform.tfvars and modify values as needed
# DO NOT commit sensitive values to version control

# AWS Configuration
aws_region = "us-east-1"

# Environment and Project Naming
environment  = "development"
project_name = "cloudops"

# VPC Configuration
vpc_cidr           = "10.0.0.0/16"
subnet_cidrs       = ["10.0.1.0/24", "10.0.2.0/24"]
availability_zones = ["us-east-1a", "us-east-1b"]

# EC2 Configuration
instance_type = "t2.micro"  # Free tier

# Security - IMPORTANT: Restrict these CIDR blocks in production!
allowed_ssh_cidrs = ["0.0.0.0/0"]  # WARNING: Open to all!
# Recommended: allowed_ssh_cidrs = ["<YOUR_IP>/32"]

# Load Balancer Configuration
enable_load_balancer = false  # Set to true to enable ALB
